{
  "name": "destra-cms-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for DESTRA CMS front-end assets",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./css/tailwind.src.css -o ../public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./css/tailwind.src.css -o ../public/assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "44.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@popperjs/core": "2.11.8",
    "admin-lte": "4.10.0",
    "bootstrap": "5.3.8",
    "chart.js": "4.6.1",
    "dropzone": "6.3.5",
    "fullcalendar": "6.1.19",
    "overlayscrollbars": "2.11.0",
    "sortablejs": "1.15.7",
    "summernote": "0.9.1",
    "sweetalert2": "11.26.25",
    "swiper": "14.3.0",
    "tinymce": "8.10.1"
  }
}
