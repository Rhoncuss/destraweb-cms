{
    "name": "destra/cms",
    "description": "DESTRA CMS - commercial publishing platform built on CodeIgniter 4.",
    "license": "proprietary",
    "type": "project",
    "homepage": "https://codecanyon.net/",
    "support": {
        "source": "https://codecanyon.net/"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "ezyang/htmlpurifier": "^4.18"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Destra\\SDK\\": "sdk/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
